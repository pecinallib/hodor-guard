{
  "name": "hodor-guard",
  "version": "0.1.0",
  "description": "Security middleware for Node.js — rate limiting, honeypot, risk scoring",
  "main": "dist/middleware/hodorGuard.js",
  "types": "dist/middleware/hodorGuard.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/example/server.ts",
