{
  "name": "hodor-guard",
  "version": "0.2.0",
  "description": "Security middleware for Node.js — rate limiting, honeypot, risk scoring",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./router": {
      "import": {
        "types": "./dist/router.d.ts",
        "default": "./dist/router.js"
      },
      "require": {
        "types": "./dist/router.d.cts",
        "default": "./dist/router.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "ts-node-dev --respawn src/example/server.ts",
    "example": "ts-node src/example/server.ts",
    "simulator": "ts-node src/example/attack-simulator.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "security",
    "middleware",
    "rate-limit",
    "honeypot",
    "express",
    "nodejs",
    "redis"
  ],
  "author": "Matheus Bastos Pecinalli",
  "license": "MIT",
  "dependencies": {
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
