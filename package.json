{
  "name": "hodor-guard",
  "version": "0.2.0",
  "description": "Security middleware for Node.js — rate limiting, honeypot, risk scoring",
  "main": "dist/cjs/middleware/hodorGuard.js",
  "module": "dist/esm/middleware/hodorGuard.js",
  "types": "dist/cjs/middleware/hodorGuard.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/middleware/hodorGuard.js",
      "require": "./dist/cjs/middleware/hodorGuard.js",
      "types": "./dist/cjs/middleware/hodorGuard.d.ts"
    },
    "./router": {
      "import": "./dist/esm/router/statsRouter.js",
      "require": "./dist/cjs/router/statsRouter.js",
      "types": "./dist/cjs/router/statsRouter.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "rimraf dist && npm run build:cjs && npm run build:esm",
    "dev": "ts-node-dev --respawn src/example/server.ts",
    "example": "ts-node src/example/server.ts",
    "simulator": "ts-node src/example/attack-simulator.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "security",
    "middleware",
    "rate-limit",
    "honeypot",
    "express",
    "nodejs",
    "redis"
  ],
  "author": "Matheus Bastos Pecinalli",
  "license": "MIT",
  "dependencies": {
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "express": "^4.18.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
